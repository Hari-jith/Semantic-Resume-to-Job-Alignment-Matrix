# Copy this file to .env and fill in real values.
# Never commit the actual .env file.

# --- Groq API ---
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# --- Embedding model ---
# Path is relative to backend/. If the fine-tuned model folder does not exist
# at this path, the app automatically falls back to the pretrained
# sentence-transformers/all-mpnet-base-v2 model from Hugging Face.
FINETUNED_MODEL_PATH=models/resume_job_mpnet_finetuned
PRETRAINED_MODEL_NAME=sentence-transformers/all-mpnet-base-v2

# --- File upload limits ---
MAX_FILE_SIZE_MB=10

# --- Scoring weights (Resume + JD mode) — must sum to 1.0 ---
WEIGHT_SEMANTIC=0.30
WEIGHT_SKILLS=0.30
WEIGHT_KEYWORDS=0.15
WEIGHT_EXPERIENCE=0.15
WEIGHT_COMPLETENESS=0.10

# --- Scoring weights (Resume-only mode) — must sum to 1.0 ---
WEIGHT_RESUME_COMPLETENESS=0.35
WEIGHT_RESUME_SKILLS=0.30
WEIGHT_RESUME_STRUCTURE=0.20
WEIGHT_RESUME_ROLE_SIGNAL=0.15

# --- CORS (frontend origin during local dev) ---
FRONTEND_ORIGIN=http://localhost:5173
